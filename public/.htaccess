# Fix It Aid: LiteSpeed / Apache config for the static export in out/.
# Upload the contents of out/ to the site root. Create quote.config.php from
# quote.config.example.php (Google SMTP App Password) — that file is not in git.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# The export has both about.html and an about/ folder (Next.js navigation data).
# Don't let the server add a slash and look inside the folder.
DirectorySlash Off

# Keep SMTP credentials and rate-limit files off the public web.
<Files "quote.config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>
<Files "quote.config.example.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One host: https://fixitaid.com (www and http redirect here).
  RewriteCond %{HTTP_HOST} ^www\.fixitaid\.com$ [NC]
  RewriteRule ^(.*)$ https://fixitaid.com/$1 [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://fixitaid.com/$1 [R=301,L]

  # Drop trailing slashes so each page has one URL (/about, not /about/).
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Clean URLs: /about serves about.html (checked before the about/ folder).
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # Hide the rate-limit store directory.
  RewriteRule ^\.quote-rate(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build files never change; everything else revalidates.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
